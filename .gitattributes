* text=auto eol=lf

# Generated files: collapsed in GitHub diffs and left out of language stats.
prunecss.schema.json linguist-generated=true
Cargo.lock linguist-generated=true
**/Cargo.lock linguist-generated=true
bench/package-lock.json linguist-generated=true
bench/results/** linguist-generated=true
crates/prunecss-cli/tests/snapshots/** linguist-generated=true

# Test inputs, not project code.
crates/prunecss-cli/tests/fixtures/** linguist-vendored=true
bench/corpus/** linguist-vendored=true
fuzz/corpus/** linguist-vendored=true

# Fuzz inputs are raw bytes; never touch their line endings.
fuzz/corpus/** -text
fuzz/regressions/** -text
