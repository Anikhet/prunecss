---
source: crates/prunecss-cli/tests/cli.rs
expression: stdout(&output)
---
@layer reset, components;

@layer reset {
  * {
    box-sizing: border-box;
  }
}

:root {
  --brand: rebeccapurple;
}

body {
  margin: 0;
  font-family: system-ui;
}

.container {
  max-width: 60rem;
  margin: 0 auto;
}

.navbar {
  display: flex;
  gap: 1rem;
}

.navbar-dark {
  background: #222;
  color: #fff;
}

.btn {
  padding: .5rem 1rem;
  border-radius: 4px;
}

.btn:hover {
  filter: brightness(1.1);
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.card {
  border: 1px solid #ddd;
}

.card .card-title {
  font-weight: bold;
}

.md\:flex {
  display: flex;
}

@media (min-width: 768px) {
  .container {
    padding: 2rem;
  }
}

@media print {
  .no-print {
    display: none;
  }
}

@keyframes spin {
  to {
    transform: rotate(1turn);
  }
}
