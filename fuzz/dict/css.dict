# libFuzzer dictionary for CSS and class-attribute markup.
# Use with: cargo +nightly fuzz run <target> -- -dict=fuzz/dict/css.dict

# Content/CSS separator used by the byte-level prune targets.
sep="\xff"

# Punctuation and combinators
"{"
"}"
";"
":"
"::"
","
"."
"#"
"&"
">"
"+"
"~"
"*"
"|"
"("
")"
"["
"]"
"="
"/*"
"*/"
"\\"
"\\:"
"\\/"
"\\31 "
"!important"

# At-rules
"@media"
"@supports"
"@container"
"@layer"
"@scope"
"@starting-style"
"@keyframes"
"@font-face"
"@property"
"@import"
"@charset"
"@namespace"
"@page"
"@nest"
"@-moz-document"
"@counter-style"
"@font-palette-values"
"@view-transition"
" and "
" not "
" only "
"print"
"screen"
"(min-width:768px)"
"(width>=600px)"
"(display:grid)"
"url-prefix()"
"selector("

# Pseudo-classes and elements
":hover"
":focus-visible"
":root"
":not("
":is("
":where("
":has("
":nth-child("
" of "
":-webkit-any("
":-moz-any("
":host("
"::slotted("
"::part("
"::before"
"::after"
":global("
":local("

# Attribute selectors
"[hidden]"
"[href^="
"[data-x~="
" i]"

# Declarations and values
"color:red"
"--x:1px"
"var(--x)"
"calc(1px + 2%)"
"url("
"content:\"\""
"animation:spin 1s"

# Markup
"class=\""
"className=\""
" class='"
"\""
"'"
"<div "
">"
